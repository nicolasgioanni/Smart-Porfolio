{
  "name": "static-first-smart-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:pages": "npm run build && npm run db:migrate:local && npx --no-install wrangler pages dev out --env-file .env",
    "db:migrate:local": "npx --no-install wrangler d1 migrations apply CONTACT_RATE_LIMIT_DB --local",
    "docs:check": "node scripts/validateDocumentation.mjs",
    "update:contact-tlds": "node scripts/updateContactTlds.mjs",
    "generate:content": "tsx scripts/fetchPortfolioContent.ts",
    "prebuild": "npm run generate:content",
    "build": "next build && node scripts/writeContentVersion.mjs",
    "build:generated": "next build && node scripts/writeContentVersion.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:priority": "node scripts/runValidationTier.mjs priority",
    "test:footer": "vitest run src/components/layout/InteractiveBlobFooter.test.tsx src/components/layout/footerStyles.test.ts",
    "test:navigation": "vitest run src/components/navigation/MobileNavigation.test.tsx src/components/navigation/navigation.test.tsx src/components/navigation/navigationStyles.test.ts src/components/responsive/useMediaQuery.test.tsx src/components/theme/ThemeSwitcher.test.tsx",
    "test:skeletons": "vitest run src/components/loading/skeleton.test.tsx src/components/loading/skeletonStyles.test.ts src/components/loading/skeletonContentContract.test.ts src/components/loading/ResearchPageSkeleton.test.tsx scripts/renderRouteSkeleton.test.mjs src/components/motion/pageEntryStyles.test.ts",
    "test:e2e:navigation": "playwright test navigation.spec.ts --project=chromium",
    "test:e2e:skeletons:alignment": "playwright test skeleton-alignment.spec.ts --project=chromium",
    "test:e2e:skeletons:visual": "playwright test skeletons.visual.spec.ts --project=chromium",
    "test:e2e:skeletons": "playwright test skeleton-alignment.spec.ts skeletons.transition.spec.ts skeletons.visual.spec.ts --project=chromium",
    "test:skeleton-guidance": "vitest run scripts/skeletonGuidance.test.mjs",
    "test:skeleton-baseline-workflow": "vitest run scripts/skeletonBaselineWorkflow.test.mjs",
    "test:e2e:footer": "playwright test footer.spec.ts --project=chromium",
    "test:e2e:recommendations": "playwright test recommendations.spec.ts --project=chromium",
    "test:e2e:experience": "playwright test experience.spec.ts --project=chromium",
    "test:e2e:research": "playwright test research.spec.ts --project=chromium",
    "test:e2e:contact": "playwright test contact.spec.ts --project=chromium",
    "test:e2e:priority": "playwright test skeleton-alignment.spec.ts navigation.spec.ts footer.spec.ts contact.spec.ts --project=chromium",
    "test:e2e:full": "playwright test --project=chromium",
    "verify": "npm run docs:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:priority": "npm run docs:check && npm run lint && npm run typecheck && npm run test:priority && npm run test:e2e:priority && npm run build",
    "verify:full": "npm run docs:check && npm run lint && npm run typecheck && npm run test && npm run test:e2e:full && npm run build",
    "setup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "dev:smart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "verify:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local.ps1",
    "clean:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-local.ps1",
    "setup:local:node": "node scripts/setup-local.mjs",
    "dev:smart:node": "node scripts/start-dev.mjs",
    "verify:local:node": "node scripts/verify-local.mjs",
    "clean:local:node": "node scripts/clean-local.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "exceljs": "4.4.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "jszip": "3.10.1",
    "miniflare": "5.20260910.0-alpha",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
